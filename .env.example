# Environment Configuration for TN Government Grievance Portal

# General
PROJECT_NAME="TN Government Grievance Portal"
ENV=development
SECRET_KEY=tn-grievance-portal-super-secret-dev-key-2026

# Database (PostgreSQL with PostGIS & pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tngrievance
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tngrievance

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=grievance-attachments
MINIO_USE_SSL=false

# AI Adapters Configuration (Default: mock for zero external dependency)
AI_STT_PROVIDER=mock       # options: mock, sarvam
AI_TTS_PROVIDER=mock       # options: mock, sarvam
AI_ROUTING_PROVIDER=mock   # options: mock, indicbert
AI_DUPLICATE_PROVIDER=mock # options: mock, qwen

# Production AI API Keys (Optional)
SARVAM_API_KEY=
HUGGINGFACE_API_KEY=

# Local Server Ports
API_PORT=8000
WEB_PORT=3000
